# .editorconfig for Musicya project
# Ensures consistent code style across all contributors

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.kt]
indent_size = 4
max_line_length = 120

[*.kts]
indent_size = 4
max_line_length = 120

[*.xml]
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
max_line_length = 0

[*.gradle]
indent_size = 4

[*.toml]
indent_size = 4

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab